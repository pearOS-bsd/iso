#!/bin/sh
# PROVIDE: wsbsd_overlay
# REQUIRE: mountcritlocal var tmp cleanvar
# BEFORE: NETWORKING SERVERS
# KEYWORD: nojail
# The live medium is read-only: /usr/local (the desktop, the frameworks, and what pkg installs) gets a writable layer in memory (unionfs: new and changed files go to /var/overlay, the medium shows through).
. /etc/rc.subr
name="wsbsd_overlay"
rcvar="wsbsd_overlay_enable"
start_cmd="wsbsd_overlay_start"
stop_cmd=":"
# unionfs (FreeBSD) deadlocks under the parallel file access of the desktop starting on a fast machine (KVM, real hardware): the desktop programs and the file system calls of the session script
# hung for good (tested: the same image reaches the desktop at once with the mount left out). So the writable layer is NOT mounted at boot any more; `service wsbsd_overlay writable` mounts it
# when it is wanted (pkg install on the live medium, a .app dragged into /Applications), best before the desktop does much, or from a text console.
extra_commands="writable"
writable_cmd="wsbsd_overlay_writable"
wsbsd_overlay_start()
{
	mkdir -p /var/run
	sysctl -q kern.coredump=0	# a crashing Mac program would write a core file of 500 MB into /var, which is memory
	[ -s /var/run/resolv.conf ] || printf 'nameserver 10.0.2.3\nnameserver 1.1.1.1\nnameserver 8.8.8.8\n' > /var/run/resolv.conf
	mount | grep -q " on /Volumes " || mount -t tmpfs -o mode=1777 tmpfs /Volumes 2>/dev/null
	# /Library/Caches is written by the services of the Mac (iconservicesd: com.apple.iconservices.store); drwxrwxrwt like the Mac's, in memory: the medium is read-only
	[ -d /Library/Caches ] && ! mount | grep -q " on /Library/Caches " && mount -t tmpfs -o mode=1777 tmpfs /Library/Caches 2>/dev/null
}
wsbsd_overlay_writable()
{
	kldload -n unionfs >/dev/null 2>&1
	mount | grep -q " on /usr/local (unionfs" && return 0
	mkdir -p /var/overlay/usr_local && mount -t unionfs -o noatime /var/overlay/usr_local /usr/local
	# /Applications takes what the user drags into it (a .app from a disk image): memory, the medium is read-only
	mkdir -p /var/overlay/applications && chmod 775 /var/overlay/applications && chgrp wheel /var/overlay/applications && mount -t unionfs -o noatime /var/overlay/applications /Applications 2>/dev/null
}
load_rc_config $name
run_rc_command "$1"
